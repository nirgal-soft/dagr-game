# Local DAGR PostgreSQL database
DATABASE_URL=postgresql://dagr:dagr@localhost:5432/dagr_dev
WORLD_SEED=0

# Optional: required only for the AI-powered Scene Playground.
ANTHROPIC_API_KEY=
# Defaults to the inexpensive Haiku model below when omitted.
DAGR_LLM_MODEL=claude-haiku-4-5-20251001

# Compile SQLx query macros from committed metadata; runtime still uses DATABASE_URL.
SQLX_OFFLINE=true
