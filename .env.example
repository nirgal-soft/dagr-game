# Optional override for the core content pack used when creating managed worlds.
DAGR_CORE_CONTENT_PATH=../dagr/content/core

# Reference-client Wilderness layout. These define a finite square-area grid
# inside each backend world container and the tile size of newly created areas.
WILDERNESS_AREA_COLUMNS=1
WILDERNESS_AREA_ROWS=1
WILDERNESS_AREA_WIDTH=64
WILDERNESS_AREA_HEIGHT=40

# Optional: required only for the AI-powered Scene Playground.
ANTHROPIC_API_KEY=
# Defaults to the inexpensive Haiku model below when omitted.
DAGR_LLM_MODEL=claude-haiku-4-5-20251001
