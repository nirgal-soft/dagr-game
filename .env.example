# Optional override for the core content pack used when creating managed worlds.
DAGR_CORE_CONTENT_PATH=../dagr/content/core

# Reference-client Wilderness layout. These define a finite square-area grid
# inside each backend world container and the tile size of newly created areas.
WILDERNESS_AREA_COLUMNS=1
WILDERNESS_AREA_ROWS=1
WILDERNESS_AREA_WIDTH=64
WILDERNESS_AREA_HEIGHT=40

# Agent runtime defaults to local Ollama; construction performs no network probe.
DAGR_AGENT_PROVIDER=ollama
DAGR_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
DAGR_AGENT_OLLAMA_TIMEOUT_SECONDS=60
DAGR_AGENT_PRIMARY_MODEL=qwen3:4b
DAGR_AGENT_PRIMARY_MAX_OUTPUT_TOKENS=1024
DAGR_AGENT_PRIMARY_OLLAMA_THINK=false
DAGR_AGENT_ECONOMY_MODEL=qwen3:4b
DAGR_AGENT_ECONOMY_MAX_OUTPUT_TOKENS=1024
DAGR_AGENT_ECONOMY_OLLAMA_THINK=false
# Optional exact overrides: gm, coordinator, faction, npc, dressing, specialist.<kind>.
DAGR_AGENT_ROLE_OVERRIDES=

# Schema-constrained generation remains a separate Ollama runtime.
DAGR_STRUCTURED_OLLAMA_BASE_URL=http://127.0.0.1:11434
DAGR_STRUCTURED_OLLAMA_TIMEOUT_SECONDS=60
DAGR_STRUCTURED_MODEL=qwen3:4b
DAGR_STRUCTURED_CONTEXT_TOKENS=32768

# To select Anthropic for the agent runtime, change DAGR_AGENT_PROVIDER, replace
# the two model values above, remove DAGR_AGENT_OLLAMA_BASE_URL,
# DAGR_AGENT_OLLAMA_TIMEOUT_SECONDS, and both DAGR_AGENT_*_OLLAMA_THINK entries,
# then set:
ANTHROPIC_API_KEY=
# DAGR_AGENT_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
# DAGR_AGENT_ANTHROPIC_TIMEOUT_SECONDS=60
# DAGR_AGENT_PRIMARY_MODEL=claude-haiku-4-5-20251001
# DAGR_AGENT_ECONOMY_MODEL=claude-haiku-4-5-20251001
# Optional thinking budgets must be at least 1024 and below the matching output cap.
# DAGR_AGENT_PRIMARY_MAX_OUTPUT_TOKENS=2048
# DAGR_AGENT_PRIMARY_ANTHROPIC_THINKING_BUDGET_TOKENS=1024
